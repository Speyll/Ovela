{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speyll.github.io/contracts/playback.schema.json",
  "title": "Ovela playback recovery decision",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": { "enum": ["next", "retry", "fail"] },
    "reason": { "type": "string" },
    "delayMs": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
