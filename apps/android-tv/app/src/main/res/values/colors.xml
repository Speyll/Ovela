    <color name="ovela_slate">#1E2328</color>
    <color name="ovela_ivory">#FAF4EB</color>
    <color name="ovela_gray">#A7A9AC</color>

    <!-- Legacy aliases for backward compatibility -->
    <color name="ovela_background">@color/ovela_deep_charcoal</color>
    <color name="ovela_accent">@color/ovela_ivory</color>
    <color name="ovela_icon_background">@color/ovela_slate</color>
</resources>
