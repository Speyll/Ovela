<resources>
    <style name="Theme.XtreamlyTV" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorAccent">#54B8FF</item>
        <item name="android:colorPrimary">#54B8FF</item>
        <item name="android:navigationBarColor">#02050A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>

    <style name="Theme.XtreamlyTV.Starting" parent="Theme.SplashScreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="windowSplashScreenBackground">#02050A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.XtreamlyTV</item>
    </style>
</resources>
